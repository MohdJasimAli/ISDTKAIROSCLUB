# Local project replica set (start-mongo.cmd on port 27018 — Prisma needs a replica set):
DATABASE_URL="mongodb://127.0.0.1:27018/isdt_kairos?replicaSet=rs0"
# Production MongoDB Atlas (Atlas is already a replica set):
# DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/isdt_kairos?retryWrites=true&w=majority"

# Local
PORT=5000
HOST=0.0.0.0
# Comma-separated allowed browser origins (CORS).
FRONTEND_URL=http://localhost:5173
# Auth cookie SameSite. Keep 'lax' when site + API share a registrable domain
# (app.isdtkairos.club + api.isdtkairos.club). Use 'none' ONLY when they are on
# different sites (e.g. *.vercel.app + *.onrender.com) before the custom domain exists.
COOKIE_SAME_SITE=lax
NODE_ENV=development

# Production: set these in the hosting provider, never in Git.
# FRONTEND_URL=https://app.isdtkairos.club
# NODE_ENV=production
# PORT=5000
# HOST=0.0.0.0

# Use independently generated values of at least 32 characters in production.
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Used only for the one-time admin seed; do not keep a real password in the repository.
ADMIN_EMAIL=admin@kairos.club
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=Kairos Admin
